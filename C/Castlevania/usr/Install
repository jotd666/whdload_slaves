;****************************

(set #sub-dir "data")		;sub directory containing data files
(set #readme-file "readme")	;name of readme file
(set #gamedir "CastleVania")     ;name of directory
(set #doc-file ("%.doc" #gamedir))	;name of dox file

;****************************

;----------------------------
; Checks if given program is reachable via the path
; if not abort install
; IN:  #program - to check
; OUT: -

(procedure P_chkrun
  (if
    (= 0 (run ("cd SYS:\nWhich %s" #program)))
    ("")
    (abort ("You must install \"%s\" first !\nIt must be accessible via the path.\nYou can find it in the whdload package." #program))
  )
)

;----------------------------
; Wait for inserting disk
; IN:  #AD_disk - name of disk
; OUT: -

(procedure P_disk
  (askdisk
    (dest #AD_disk)
    (prompt ("\nInsert Disk \"%s\" in any drive !" #AD_disk))
    (help @askdisk-help)
  )
)


;****************************

(if
  (exists #readme-file)
  (if 
    (= 0 (run ("SYS:Utilities/Multiview %s" #readme-file)))
    ("")
    (run ("SYS:Utilities/More %s" #readme-file))
  )
)

(set #program "WHDLoad")
(P_chkrun)

(set default-dest
  (askdir
    (prompt ("Where should \"%s\" installed ?\nA drawer \"%s\" will automatically created." @app-name #gamedir))
    (help @askdir-help)
    (default @default-dest)
    (disk)
  )
)
(set @default-dest default-dest)

(set #dest (tackon @default-dest #gamedir))
(if
  (exists #dest)
  (
    (set #choice
      (askbool
        (prompt ("\nDirectory \"%s\" already exists.\n Should it be deleted ?" #dest))
        (default 1)
        (choices "Delete" "Skip")
        (help @askbool-help)
      )
    )
    (if
      (= #choice 1)
      (run ("Delete \"%s\" \"%s.info\" All" #dest #dest))
    )
  )
)
(makedir #dest
  (help @makedir-help)
  (infos)
)

;----------------------------

(copyfiles
  (help @copyfiles-help)
  (source ("%s.slave" #gamedir))
  (dest #dest)
)

  (set #icon
    (askchoice
      (prompt "\nWhich icon (created by Frank) do you like to install ?\n")
      (default 0)
      (choices "Newicon" "Glowicon")
      (help @askchoice-help)
    )
  )

(select #icon
  (set #icon ("%s.newicon" #gamedir))
  (set #icon ("%s.glowicon" #gamedir))
)

(copyfiles
  (help @copyfiles-help)
  (source #icon)
  (newname ("%s.info" #gamedir))
  (dest #dest)
)
(if
  (exists #readme-file)
  (copyfiles
    (help @copyfiles-help)
    (source #readme-file)
    (dest #dest)
  )
)

(if
  (exists ("%s.info" #readme-file))
  (copyfiles
    (help @copyfiles-help)
    (source ("%s.info" #readme-file))
    (dest #dest)
  )
)

(if
  (exists #doc-file)
  (copyfiles
    (help @copyfiles-help)
    (source #doc-file)
    (dest #dest)
  )
)


(if
  (exists ("%s.info" #doc-file))
  (copyfiles
    (help @copyfiles-help)
    (source ("%s.info" #doc-file))
    (dest #dest)
  )
)

(if
  (= #sub-dir "")
  ("")
  (
    (set #datadest (tackon #dest #sub-dir))
    (makedir #datadest
      (help @makedir-help)
    )
  )
)

;----------------------------


(set #AD_disk @app-name)
(P_disk)

(copyfiles
  (help @copyfiles-help)
  (source ("%s:" #AD_disk))
  (dest  #datadest)
  (files)
  (pattern "~(#?.info)")
)
(copyfiles
  (help @copyfiles-help)
  (source ("%s:art" #AD_disk))
  (dest  (tackon #datadest "art"))
  (all)
)
(copyfiles
  (help @copyfiles-help)
  (source ("%s:sounds" #AD_disk))
  (dest  (tackon #datadest "sounds"))
  (all)
)
(copyfiles
  (help @copyfiles-help)
  (source ("%s:screens" #AD_disk))
  (dest  (tackon #datadest "screens"))
  (all)
)


; open drawer if opendrawer command is available

  (if
    (= 0 (run "cd SYS:\nWhich opendrawer"))
    (run ("opendrawer %s" #dest))
    ("")
  )

(exit)
